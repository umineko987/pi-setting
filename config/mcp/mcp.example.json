{
  "mcpServers": {
    "fast-context": {
      "command": "npx",
      "args": [
        "-y",
        "@sammysnake/fast-context-mcp@1.3.2"
      ],
      "exposure": "deferred",
      "toolExposure": {
        "extract_windsurf_key": "hidden"
      },
      "description": "按语义搜索代码库，定位相关文件和调用链"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--extension"
      ],
      "exposure": "deferred",
      "description": "浏览器自动化、网页交互与页面检查"
    }
  }
}

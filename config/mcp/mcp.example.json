{
  "mcpServers": {
    "fast-context": {
      "command": "npx",
      "args": [
        "-y",
        "@sammysnake/fast-context-mcp@1.3.2"
      ],
      "lifecycle": "lazy"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--extension"
      ],
      "lifecycle": "lazy"
    }
  }
}

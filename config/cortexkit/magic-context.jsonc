{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "enabled": true,
  "todowrite": {
    "enabled": true,
    "overlay": true
  },
  "compaction": {
    "enabled": true
  },
  "historian": {
    "pi": {
      "model": "zai-coding-cn/glm-5.3-flash",
      "thinking_level": "max"
    }
  },
  "memory": {
    "enabled": false,
    "auto_promote": false,
    "auto_search": {
      "enabled": false
    },
    "git_commit_indexing": {
      "enabled": false
    }
  },
  "dreamer": {
    "disable": true,
    "inject_docs": false,
    "tasks": {
      "review-user-memories": { "schedule": "" },
      "promote-primers": { "schedule": "" }
    }
  },
  "prompt_surface": {
    "guidance_override_path": "magic-context-compression-only.md"
  },
  "embedding": {
    "provider": "off"
  },
  "sidekick": {
    "disable": true
  }
}

{
  "theme": "wallpaper-dark",
  "defaultTools": [
    "+replace_within"
  ],
  "packages": [
    "npm:pi-supergsd@0.2.10",
    "npm:@juicesharp/rpiv-ask-user-question@2.12.0",
    "npm:@juicesharp/rpiv-i18n@2.12.0",
    "npm:@parallel-web/pi-extension@1.3.0",
    "npm:pi-token-stats@0.1.1",
    "npm:pi-mcp-adapter@5.0.0",
    "npm:@ogulcancelik/pi-ssh-tools@0.1.6",
    "npm:pi-hashline-edit-pro@5.1.0",
    "npm:@cortexkit/pi-magic-context@0.44.4"
  ],
  "defaultThinkingLevel": "max",
  "tuiMode": "regular",
  "fullscreenScrollbar": "auto",
  "retry": {
    "enabled": true,
    "maxRetries": 6,
    "baseDelayMs": 5000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 300000
    }
  },
  "hideThinkingBlock": false,
  "compaction": {
    "enabled": true
  },
  "piSupergsd": {
    "defaultTaskThinkingLevel": "max"
  },
  "extensions": [
    "-builtin:mcp"
  ]
}
